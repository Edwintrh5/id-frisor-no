---
import "../styles/global.css";
import { salong } from "../data/kontakt";

interface Props {
  tittel: string;
  beskrivelse: string;
}

const { tittel, beskrivelse } = Astro.props;

const seksjoner = [
  { id: "om", navn: "Om salongen" },
  { id: "priser", navn: "Priser" },
  { id: "galleri", navn: "Galleri" },
  { id: "kontakt", navn: "Finn oss" },
];

// Strukturerte data slik at Google viser salongen riktig i søk.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HairSalon",
  name: salong.navn,
  telephone: salong.telefonLenke,
  url: Astro.site?.href,
  address: {
    "@type": "PostalAddress",
    streetAddress: salong.gate,
    postalCode: salong.postnummer,
    addressLocality: salong.poststed,
    addressCountry: "NO",
  },
};
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Libre Caslon Display finnes bare i vekt 400. Ikke be om andre
         vekter — da syntetiserer nettleseren en falsk fet variant. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&display=swap"
    />
    <title>{tittel}</title>
    <meta name="description" content={beskrivelse} />
    <meta property="og:title" content={tittel} />
    <meta property="og:description" content={beskrivelse} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nb_NO" />
    <link rel="canonical" href={Astro.site?.href} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body>
    <a
      href="#innhold"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-green-900 focus:px-4 focus:py-2 focus:text-beige-100"
    >
      Hopp til innholdet
    </a>

    <header
      class="sticky top-0 z-40 border-b border-beige-300 bg-beige-100/90 backdrop-blur-sm"
    >
      <nav
        aria-label="Hovedmeny"
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3"
      >
        <a
          href="#hero"
          class="serif shrink-0 text-xl text-green-900 sm:text-2xl"
        >
          I.D Frisør
        </a>
        <ul class="hidden items-center gap-6 text-sm sm:flex">
          {
            seksjoner.map((s) => (
              <li>
                <a
                  href={`#${s.id}`}
                  class="inline-block py-2 text-green-900 underline-offset-4 transition-colors hover:text-green-600 hover:underline"
                >
                  {s.navn}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href={`tel:${salong.telefonLenke}`}
          class="shrink-0 rounded-full bg-green-600 px-4 py-2 text-sm font-medium text-beige-100 transition-colors hover:bg-green-900"
        >
          Ring oss
        </a>
      </nav>
    </header>

    <main id="innhold">
      <slot />
    </main>

    <footer class="border-t border-beige-300 bg-green-900 text-beige-100">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-2 px-5 py-10 text-sm sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <p class="serif text-2xl">I.D Frisør</p>
          <p class="mt-2 text-beige-100/80">
            {salong.gate}, {salong.postnummer} {salong.poststed}
          </p>
          <a
            href={`tel:${salong.telefonLenke}`}
            class="mt-1 inline-block py-1 underline underline-offset-4 hover:text-green-300"
          >
            {salong.telefonVist}
          </a>
        </div>
        <p class="text-beige-100/70">
          © {new Date().getFullYear()} I.D Frisør
        </p>
      </div>
    </footer>
  </body>
</html>
