---
import Phone from "@lucide/astro/icons/phone";
import MapPin from "@lucide/astro/icons/map-pin";
import Clock from "@lucide/astro/icons/clock";
import ExternalLink from "@lucide/astro/icons/external-link";
import { salong, apningstider, apningstiderMerknad } from "../data/kontakt";

const manglerTider = apningstider.some((d) => d.tider === null);
---

<section id="kontakt" class="border-t border-beige-300 bg-green-900 text-beige-100">
  <div class="mx-auto max-w-5xl px-5 py-20">
    <h2 class="text-3xl text-beige-100 sm:text-4xl">Finn oss</h2>

    <div class="mt-12 grid gap-12 sm:grid-cols-2">
      <div>
        <h3 class="flex items-center gap-2.5 text-xl text-beige-100">
          <MapPin
            size={20}
            strokeWidth={1.5}
            class="text-green-300"
            aria-hidden="true"
          />
          Adresse
        </h3>
        <address class="mt-4 text-[15px] leading-relaxed text-beige-100/85 not-italic">
          {salong.navn}<br />
          {salong.gate}<br />
          {salong.postnummer} {salong.poststed}
        </address>
        <p class="mt-3 text-[15px] leading-relaxed text-beige-100/70">
          {salong.naerhet}
        </p>
        <a
          href={salong.kartlenke}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 py-1 text-[15px] text-green-300 underline underline-offset-4 hover:text-beige-100"
        >
          Åpne i Google Maps
          <ExternalLink size={16} strokeWidth={1.5} aria-hidden="true" />
        </a>

        <h3 class="mt-10 flex items-center gap-2.5 text-xl text-beige-100">
          <Phone
            size={20}
            strokeWidth={1.5}
            class="text-green-300"
            aria-hidden="true"
          />
          Telefon
        </h3>
        <p class="mt-4 text-[15px] text-beige-100/85">
          Timer bestilles på telefon — vi har ingen nettbestilling.
        </p>
        <a
          href={`tel:${salong.telefonLenke}`}
          class="mt-5 inline-flex items-center justify-center gap-2.5 rounded-full bg-beige-100 px-7 py-4 text-base font-medium text-green-900 transition-colors hover:bg-green-300"
        >
          <Phone size={20} strokeWidth={1.5} aria-hidden="true" />
          {salong.telefonVist}
        </a>
      </div>

      <div>
        <h3 class="flex items-center gap-2.5 text-xl text-beige-100">
          <Clock
            size={20}
            strokeWidth={1.5}
            class="text-green-300"
            aria-hidden="true"
          />
          Åpningstider
        </h3>
        <dl class="mt-4">
          {
            apningstider.map((dag) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-beige-100/15 py-3 text-[15px]">
                <dt class="text-beige-100/85">{dag.dag}</dt>
                <dd
                  class={
                    dag.tider
                      ? "font-medium text-beige-100"
                      : "text-beige-100/55 italic"
                  }
                >
                  {dag.tider ?? "oppdateres"}
                </dd>
              </div>
            ))
          }
        </dl>
        {
          manglerTider && (
            <p class="mt-5 text-sm leading-relaxed text-beige-100/70">
              {apningstiderMerknad}
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>
